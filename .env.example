# 백엔드 API 베이스 URL
# MSW 목업으로 개발할 때는 /api (같은 origin)로 둬야 서비스워커가 요청을 가로챈다.
# Vercel 배포도 /api 유지 — vercel.json이 /api/* 를 실서버로 프록시한다.
# 로컬에서 백엔드에 직접 붙을 때만 http://localhost:8080/api 같은 절대 URL로 바꾼다.
VITE_API_BASE_URL=/api

# MSW 목업 서버 활성화 여부
# 개발: true = 전체 목업. 배포(vercel.json build.env): true = BE 미구현 도메인만 목업하는 하이브리드
VITE_ENABLE_MSW=true

# 시연용 가상 사용자 목록(JSON) — 하이브리드 배포에서 /virtual-users 목업이 반환할 값.
# id는 실서버 DB에 등록된 UUID여야 한다(아니면 X-User-ID 형식·등록 오류).
# 형식: [{"id":"<uuid>","name":"김도윤","role":"USER","membership":"vip","personaLabel":null}]
# Vercel 대시보드 환경변수에 실제 값을 넣고 재배포한다.
# VITE_VIRTUAL_USERS_JSON=
